{
  "name": "news24-shivneri",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply news24-db --local",
    "db:remote": "wrangler d1 migrations apply news24-db --remote",
    "db:seed-local": "wrangler d1 execute news24-db --local --file=seed/sample.sql",
    "admin:create": "node scripts/make-admin.mjs",
    "db:admin-local": "wrangler d1 execute news24-db --local --file=seed/admin.sql",
    "db:demo-local": "node scripts/load-demo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "astro": "^7.4.7",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.158.0"
  }
}
