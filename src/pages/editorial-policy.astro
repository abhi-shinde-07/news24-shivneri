---
import Base from '../layouts/Base.astro';
import { getDB } from '../lib/db';
import { getSettings } from '../lib/settings';
const s = await getSettings(getDB(Astro.locals), Astro.locals);
---
<Base title="संपादकीय धोरण – NEWS24 SHIVNERI" description="NEWS24 SHIVNERI चे संपादकीय धोरण: स्रोत, पडताळणी, सुधारणा आणि जाहिरात नियम.">
  <article class="article-body page">
    <h1 class="h-lead">संपादकीय धोरण</h1>
    <p class="deck">अचूकता, निष्पक्षता आणि पारदर्शकता हा आमच्या पत्रकारितेचा पाया आहे.</p>
    <h2>१. स्रोत आणि पडताळणी</h2>
    <p>प्रत्येक बातमीसोबत तिचा स्रोत (प्रत्यक्ष भेट, अधिकृत निवेदन, पत्रकार परिषद, कागदपत्रे इ.) नमूद केला जातो. अपुष्ट माहिती बातमी म्हणून प्रकाशित केली जात नाही.</p>
    <h2>२. लेखक आणि तारीख</h2>
    <p>प्रत्येक बातमीवर प्रतिनिधीचे किंवा डेस्कचे नाव, प्रकाशनाची वेळ आणि बदल झाल्यास “अद्यतनित” वेळ दाखवली जाते.</p>
    <h2>३. सुधारणा</h2>
    <p>चूक लक्षात आल्यास ती दुरुस्त करून बातमीखाली तारखेसह सुधारणा दिली जाते. सर्व सुधारणा <a href="/corrections">सुधारणा</a> पानावर एकत्र उपलब्ध आहेत.</p>
    <h2>४. जाहिरात आणि बातमी</h2>
    <p>जाहिरातींवर “जाहिरात” असे स्पष्ट लिहिलेले असते. जाहिरातदारांचा बातम्यांच्या निवडीवर किंवा मजकुरावर प्रभाव नसतो.</p>
    <h2>५. छायाचित्रे</h2>
    <p>छायाचित्राचे श्रेय दिले जाते. प्रतीकात्मक छायाचित्र असल्यास तसे नमूद केले जाते.</p>
    <h2>६. गोपनीयता आणि संवेदनशीलता</h2>
    <p>पीडित, अल्पवयीन व्यक्ती आणि संवेदनशील प्रकरणांत ओळख उघड केली जात नाही.</p>
    <h2>७. तक्रार निवारण</h2>
    <p>तक्रार निवारण अधिकारी: <b>{s.grievance_name}</b>, {s.grievance_address}. ईमेल: {s.contact_email}</p>
  </article>
</Base>
