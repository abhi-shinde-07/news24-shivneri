---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Card from '../../components/Card.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getDB, getArticle } from '../../lib/db';
import { fmtDate } from '../../lib/format';
import { mediaUrl, rewriteBody, thumbOf } from '../../lib/mediaUrl';
import { SITE } from '../../lib/page';
const id = Number(Astro.params.id);
const data = Number.isInteger(id) ? await getArticle(getDB(Astro.locals), id) : null;
if (!data) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
const { article: a, corrections, related } = data;
const edited = a.updated_at > a.published_at;
const url = `${SITE}/news/${a.id}`;
const thumb = thumbOf(a);
const img = thumb ? new URL(thumb, SITE).href : `${SITE}/og-image.png`;
const description = a.subtitle ?? (a.body_html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160) || a.headline);
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: a.headline.slice(0, 110), description,
  image: [img], datePublished: a.published_at, dateModified: a.updated_at,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url }, articleSection: a.category_name,
  ...(a.location_label ? { contentLocation: { '@type': 'Place', name: a.location_label } } : {}),
  author: { '@type': 'Person', name: a.byline },
  publisher: { '@type': 'NewsMediaOrganization', name: 'NEWS24 SHIVNERI', url: SITE, logo: { '@type': 'ImageObject', url: `${SITE}/logo.png`, width: 1200, height: 1200 } },
  inLanguage: 'mr',
}).replace(/</g, '\\u003c');
const share = encodeURIComponent(`${a.headline}\n${url}`);
---
<Base title={`${a.headline} – NEWS24 SHIVNERI`} description={description} canonical={`/news/${a.id}`}
  type="article" image={thumb ?? undefined} published={a.published_at} modified={a.updated_at}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <div class="with-side"><div class="main-col">
  <article class="article-body">
    <p class="crumbs"><a href="/">मुख्यपृष्ठ</a> › <a href={`/category/${a.category_slug}`}>{a.category_name}</a>{a.location_label && <> · {a.location_label}</>}</p>
    <h1 class="h-lead">{a.headline}</h1>
    {a.subtitle && <p class="deck">{a.subtitle}</p>}
    <div class="meta">
      <p class="byline"><b>{a.byline}</b> · स्रोत: {a.source}</p>
      <p class="byline">प्रकाशित: <time datetime={a.published_at}>{fmtDate(a.published_at)}</time>{edited && <> · अद्यतनित: <time datetime={a.updated_at}>{fmtDate(a.updated_at)}</time></>}</p>
    </div>
    <div class="share">
      <a class="wa" href={`https://wa.me/?text=${share}`} target="_blank" rel="noopener">WhatsApp वर शेअर करा</a>
      <button type="button" data-copy={url} hidden>लिंक कॉपी करा</button>
    </div>
    {a.main_image_key && <img class="lead-img" src={mediaUrl(a.main_image_key)} alt={a.main_image_caption ?? a.headline} width="1200" height="675" fetchpriority="high" />}
    {(a.main_image_caption || a.image_credit) && <p class="caption">{a.main_image_caption}{a.image_credit && <> · श्रेय: {a.image_credit}</>}</p>}
    <AdSlot position="in_between" />
    <!-- body_html is sanitized when saved (Phase 5) -->
    <div class="body" set:html={rewriteBody(a.body_html)} />
    {a.youtube_id && (
      <section class="art-video" aria-label="व्हिडिओ"><h2 class="section-head">या बातमीचा व्हिडिओ</h2><div class="player">
        <button type="button" data-yt={a.youtube_id} aria-label={`व्हिडिओ चालू करा: ${a.headline}`}>
          <img src={`https://i.ytimg.com/vi/${a.youtube_id}/hqdefault.jpg`} alt="" width="480" height="360" /><span class="play" aria-hidden="true">▶</span>
        </button>
      </div></section>)}
    {corrections.length > 0 && (
      <section aria-label="सुधारणा">
        {corrections.map((c) => <div class="correction"><b>सुधारणा</b> ({fmtDate(c.created_at)}): {c.note}</div>)}
      </section>
    )}
    <p class="byline policy">ही बातमी आमच्या <a href="/editorial-policy">संपादकीय धोरणा</a>नुसार प्रकाशित केली आहे. चूक आढळल्यास <a href="/contact">आम्हाला कळवा</a>.</p>
  </article>
  {related.length > 0 && (
    <section class="related">
      <h2 class="section-head">याच विभागातील इतर बातम्या</h2>
      <div class="list two">{related.map((r) => <Card a={r} tag="h3" showCat={false} />)}</div>
    </section>)}
  </div>
  <Sidebar exclude={a.id} />
  </div>
</Base>
