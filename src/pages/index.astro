---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDB, getHome, getCategoryBlocks, getFeaturedVideos, getLatestEpaper } from '../lib/db';
import { thumbOf } from '../lib/mediaUrl';
import { fmtDay, fmtDate } from '../lib/format';
import { catStyle } from '../lib/colors';
const db = getDB(Astro.locals);
const [{ lead, others, more, top, grid, breaking }, blocks, videos, epaper] =
  await Promise.all([getHome(db), getCategoryBlocks(db), getFeaturedVideos(db, 4), getLatestEpaper(db)]);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: 'NEWS24 SHIVNERI',
  alternateName: 'NEWS24 शिवनेरी', url: 'https://www.news24shivneri.in/', logo: 'https://www.news24shivneri.in/logo.png',
  slogan: 'निर्भिड सत्याचा बुलंद आवाज',
}).replace(/</g, '\\u003c');
---
<Base canonical="/">
  <script slot="head" type="application/ld+json" set:html={ld} />
  {breaking.length > 0 && (
    <div class="breaking"><strong>ब्रेकिंग</strong>
      <ul>{breaking.map((b) => <li><a href={`/news/${b.id}`}>{b.headline}</a></li>)}</ul></div>)}
  <AdSlot position="main_headline" />
  {!lead && <p class="deck">अद्याप बातम्या प्रकाशित झालेल्या नाहीत.</p>}
  {lead && (
  <section class="front2">
    <a class="hero" href={`/news/${lead.id}`} style={catStyle(lead.category_slug)}>
      {thumbOf(lead) ? <img src={thumbOf(lead, lead.main_image_key ? undefined : 'hqdefault')!} alt={lead.main_image_caption ?? lead.headline} width="1200" height="675" fetchpriority="high" />
        : <span class="tnone">NEWS24 शिवनेरी</span>}
      <span class="hero-cap">
        <span class="kicker">{lead.category_name}</span>
        <span class="hero-h">{lead.headline}</span>
        <span class="hero-meta">{lead.location_label && <>{lead.location_label} · </>}{fmtDate(lead.published_at)}</span>
      </span>
    </a>
    <div class="topcards">
      <h2 class="bar-head">आजच्या प्रमुख बातम्या</h2>
      {others.concat(more).slice(0, 5).map((a) => (
        <a class="mini" href={`/news/${a.id}`} style={catStyle(a.category_slug)}>
          {thumbOf(a, 'mqdefault') ? <img src={thumbOf(a, 'mqdefault')!} alt="" loading="lazy" width="120" height="68" /> : <span class="tnone"></span>}
          <span><span class="kicker">{a.category_name}</span><b>{a.headline}</b></span>
        </a>))}
    </div>
  </section>)}
  <AdSlot position="in_between" />
  {(top.length > 0 || epaper) && (
    <section class="strip">
      <div>
        <h2 class="bar-head">ताज्या बातम्या</h2>
        <div class="tgrid">{top.concat(grid).slice(0, 8).map((a) => (
          <a class="tcard" href={`/news/${a.id}`} style={catStyle(a.category_slug)}>
            {thumbOf(a) ? <img src={thumbOf(a)!} alt="" loading="lazy" width="400" height="225" /> : <span class="tnone">NEWS24 शिवनेरी</span>}
            <span class="kicker">{a.category_name}</span>
            <b>{a.headline}</b>
            {a.location_label && <small>{a.location_label}</small>}
          </a>))}</div>
      </div>
      <aside class="strip-side">
        <AdSlot position="sidebar" />
        {epaper && (
          <div class="epaper-box">
            <h2 class="bar-head">ई-पेपर</h2>
            <a href={`/epaper/${epaper.edition_date}`}>
              {epaper.cover_key && <img src={`/files/${epaper.cover_key}`} alt={`ई-पेपर ${fmtDay(epaper.edition_date)}`} loading="lazy" width="300" height="420" />}
              <b>{epaper.title}</b><span>{fmtDay(epaper.edition_date)}</span>
            </a>
          </div>)}
        <div class="side-cta"><b>तुमच्या परिसरातील बातमी आम्हाला कळवा</b><a class="btn" href="/contact">संपर्क करा</a></div>
      </aside>
    </section>)}
  {blocks.map((b) => (
    <section class="catrow" style={catStyle(b.slug)}>
      <h2 class="cat-head"><a href={`/category/${b.slug}`}>{b.name}</a><span></span><a class="more" href={`/category/${b.slug}`}>सर्व पहा ›</a></h2>
      <div class="tgrid">{b.items.map((a) => (
        <a class="tcard" href={`/news/${a.id}`}>
          {thumbOf(a) ? <img src={thumbOf(a)!} alt="" loading="lazy" width="400" height="225" /> : <span class="tnone">NEWS24 शिवनेरी</span>}
          <b>{a.headline}</b>
          {a.location_label && <small>{a.location_label}</small>}
        </a>))}</div>
    </section>))}
  {videos.length > 0 && (
    <section>
      <h2 class="cat-head" style="--c:#141414"><a href="/videos">व्हिडिओ</a><span></span><a class="more" href="/videos">सर्व पहा ›</a></h2>
      <div class="vgrid">{videos.map((v) => (
        <a class="vcard" href={`/videos/${v.id}`}>
          <span class="vthumb"><img src={`https://i.ytimg.com/vi/${v.youtube_id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" /><span class="play" aria-hidden="true">▶</span></span>
          <b>{v.title}</b></a>))}</div>
    </section>)}
</Base>
