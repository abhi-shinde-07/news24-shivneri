---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Byline from '../components/Byline.astro';
import { getDB, getHome } from '../lib/db';
import { mediaUrl } from '../lib/mediaUrl';
const { lead, others, top, breaking } = await getHome(getDB(Astro.locals));
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---
<Base>
  {breaking && <div class="breaking"><strong>ताज्या बातम्या</strong><a href={`/news/${breaking.id}`}>{breaking.headline}</a></div>}
  <AdSlot position="main_headline" />
  {!lead && <p class="deck">अद्याप बातम्या प्रकाशित झालेल्या नाहीत.</p>}
  {lead && (
  <section class="front">
    <div class="col">
      {lead.main_image_key && <img src={mediaUrl(lead.main_image_key)} alt={lead.main_image_caption ?? lead.headline} />}
      {lead.main_image_caption && <p class="caption">{lead.main_image_caption}</p>}
      <h1 class="h-lead"><a href={`/news/${lead.id}`}>{lead.headline}</a></h1>
      {lead.subtitle && <p class="deck">{lead.subtitle}</p>}
      <Byline a={lead} />
    </div>
    <div class="col">
      <h2 class="section-head first">इतर महत्त्वाच्या बातम्या</h2>
      {others.map((a) => <div class="item"><h3 class="h-mid"><a href={`/news/${a.id}`}>{a.headline}</a></h3><Byline a={a} /></div>)}
    </div>
    <div class="col">
      <AdSlot position="sidebar" />
      <h2 class="section-head first">आजच्या प्रमुख बातम्या</h2>
      {top.map((a) => <div class="item"><h3 class="h-small"><a href={`/news/${a.id}`}>{a.headline}</a></h3></div>)}
    </div>
  </section>)}
  <AdSlot position="in_between" />
</Base>
