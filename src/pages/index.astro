---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDB, getHome, getCategoryBlocks, getHomeVideos, getLatestEpaper } from '../lib/db';
import { thumbOf, rewriteBody } from '../lib/mediaUrl';
import { fmtDay, fmtDate, excerpt } from '../lib/format';
import { catStyle } from '../lib/colors';
const db = getDB(Astro.locals);
const [{ lead, others, more, top, grid, breaking }, blocks, videos, epaper] =
  await Promise.all([getHome(db), getCategoryBlocks(db), getHomeVideos(db, 4), getLatestEpaper(db)]);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
const main = others.concat(more).slice(0, 4);
const latest = top.concat(grid).slice(0, 8);
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: 'NEWS24 SHIVNERI',
  alternateName: 'NEWS24 शिवनेरी', url: 'https://www.news24shivneri.in/', logo: 'https://www.news24shivneri.in/logo.png',
  slogan: 'निर्भिड सत्याचा बुलंद आवाज',
}).replace(/</g, '\u003c');
---
<Base canonical="/">
  <script slot="head" type="application/ld+json" set:html={ld} />
  {breaking.length > 0 && (
    <div class="breaking"><strong>ब्रेकिंग</strong>
      <ul>{breaking.map((b) => <li><a href={`/news/${b.id}`}>{b.headline}</a></li>)}</ul></div>)}
  <AdSlot position="main_headline" />
  {!lead && <p class="deck">अद्याप बातम्या प्रकाशित झालेल्या नाहीत.</p>}
  {lead && (
  <section class="lead3" style={catStyle(lead.category_slug)}>
    <a class="lead3-img" href={`/news/${lead.id}`}>
      {thumbOf(lead) ? <img src={thumbOf(lead, lead.main_image_key ? undefined : 'hqdefault')!} alt={lead.main_image_caption ?? lead.headline} width="1200" height="675" fetchpriority="high" />
        : <span class="tnone">NEWS24 शिवनेरी</span>}
    </a>
    <div class="lead3-text">
      <span class="kicker">{lead.category_name}</span>
      <h1 class="lead3-h"><a href={`/news/${lead.id}`}>{lead.headline}</a></h1>
      <p class="lead3-meta">{lead.location_label && <>{lead.location_label} · </>}{fmtDate(lead.published_at)}</p>
      {lead.subtitle && <p class="lead3-sub">{lead.subtitle}</p>}
      <p class="lead3-ex">{excerpt(lead.body_html, 360)}</p>
      <details class="readhere"><summary>इथेच पूर्ण बातमी वाचा ▾</summary><div class="body" set:html={rewriteBody(lead.body_html)} /></details>
    </div>
  </section>)}
  {main.length > 0 && (
    <section class="mainrow">
      <h2 class="bar-head">आजच्या प्रमुख बातम्या</h2>
      <div class="tgrid">{main.map((a) => (
        <article class="tcard rcard" style={catStyle(a.category_slug)}>
          <a href={`/news/${a.id}`} class="rcard-img">{thumbOf(a) ? <img src={thumbOf(a)!} alt="" loading="lazy" width="400" height="225" /> : <span class="tnone">NEWS24 शिवनेरी</span>}</a>
          <span class="kicker">{a.category_name}</span>
          <h3><a href={`/news/${a.id}`}>{a.headline}</a></h3>
          <p class="ex">{excerpt(a.body_html, 160)}</p>
          <details class="readhere"><summary>इथेच वाचा ▾</summary><div class="body" set:html={rewriteBody(a.body_html)} /></details>
        </article>))}</div>
    </section>)}
  <AdSlot position="in_between" />
  <section class="cta-band">
    <div class="cta-icon" aria-hidden="true">📣</div>
    <div class="cta-main"><small>वाचकांचा आवाज</small><b>तुमच्या परिसरातील बातमी आम्हाला कळवा</b>
      <span>घटना, समस्या, कार्यक्रम किंवा यश — फोटो आणि व्हिडिओसह पाठवा. तुमची बातमी NEWS24 शिवनेरी वर झळकेल.</span>
      <a class="btn" href="/contact">✍️ बातमी पाठवा</a></div>
    {epaper && (
      <a class="cta-epaper" href={`/epaper/${epaper.edition_date}`}>
        {epaper.cover_key && <img src={`/files/${epaper.cover_key}`} alt="" loading="lazy" width="90" height="126" />}
        <span><b>आजचा ई-पेपर</b><small>{fmtDay(epaper.edition_date)}</small><em>वाचा ›</em></span>
      </a>)}
  </section>
  {latest.length > 0 && (
    <section class="catrow" style="--c:#c4001f">
      <h2 class="cat-head"><a href="/latest">ताज्या बातम्या</a><span></span><a class="more" href="/latest">सर्व पहा ›</a></h2>
      <div class="tgrid">{latest.map((a) => (
        <a class="tcard" href={`/news/${a.id}`} style={catStyle(a.category_slug)}>
          {thumbOf(a) ? <img src={thumbOf(a)!} alt="" loading="lazy" width="400" height="225" /> : <span class="tnone">NEWS24 शिवनेरी</span>}
          <span class="kicker">{a.category_name}</span>
          <b>{a.headline}</b>
          <span class="ex">{excerpt(a.body_html, 110)}</span>
          {a.location_label && <small>{a.location_label}</small>}
        </a>))}</div>
    </section>)}
  <AdSlot position="sidebar" />
  {blocks.map((b) => (
    <section class="catrow" style={catStyle(b.slug)}>
      <h2 class="cat-head"><a href={`/category/${b.slug}`}>{b.name}</a><span></span><a class="more" href={`/category/${b.slug}`}>सर्व पहा ›</a></h2>
      <div class="tgrid">{b.items.map((a) => (
        <a class="tcard" href={`/news/${a.id}`}>
          {thumbOf(a) ? <img src={thumbOf(a)!} alt="" loading="lazy" width="400" height="225" /> : <span class="tnone">NEWS24 शिवनेरी</span>}
          <b>{a.headline}</b>
          {a.location_label && <small>{a.location_label}</small>}
        </a>))}</div>
    </section>))}
  {videos.length > 0 && (
    <section>
      <h2 class="cat-head" style="--c:#141414"><a href="/videos">व्हिडिओ</a><span></span><a class="more" href="/videos">सर्व पहा ›</a></h2>
      <div class="vgrid">{videos.map((v) => (
        <a class="vcard" href={v.href}>
          <span class="vthumb"><img src={`https://i.ytimg.com/vi/${v.youtube_id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" /><span class="play" aria-hidden="true">▶</span></span>
          <b>{v.title}</b></a>))}</div>
    </section>)}
</Base>
