---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ArticleEditor from '../../../components/ArticleEditor';
import { getDB } from '../../../lib/db';
import { fmtDate } from '../../../lib/format';
const db = getDB(Astro.locals);
const id = Number(Astro.params.id);
const a = Number.isInteger(id) ? await db.prepare('SELECT * FROM articles WHERE id = ?').bind(id).first<any>() : null;
if (!a) return new Response('बातमी सापडली नाही', { status: 404 });
const cats = (await db.prepare('SELECT id, name_mr FROM categories WHERE is_active = 1 OR id = ? ORDER BY sort_order').bind(a.category_id).all<{ id: number; name_mr: string }>()).results;
const corrections = (await db.prepare('SELECT note, created_at FROM corrections WHERE article_id = ? ORDER BY created_at DESC').bind(id).all<{ note: string; created_at: string }>()).results;
const revisions = (await db.prepare(
  `SELECT r.id, r.headline, r.saved_at, u.name FROM article_revisions r LEFT JOIN users u ON u.id = r.saved_by
   WHERE r.article_id = ? ORDER BY r.saved_at DESC, r.id DESC LIMIT 50`).bind(id)
  .all<{ id: number; headline: string; saved_at: string; name: string | null }>()).results;
const initial = {
  id, headline: a.headline, subtitle: a.subtitle ?? '', body_html: a.body_html, category_id: a.category_id,
  location_label: a.location_label ?? '', byline: a.byline, source: a.source, image_credit: a.image_credit ?? '', main_image_key: a.main_image_key ?? '', main_image_caption: a.main_image_caption ?? '',
  is_featured: !!a.is_featured, is_breaking: !!a.is_breaking, status: a.status,
};
---
<AdminLayout title="बातमी संपादित करा">
  <h2>बातमी संपादित करा {a.status === 'published' && <a href={`/news/${id}`} target="_blank" rel="noopener" style="font-size:.9rem">(वेबसाइटवर पहा)</a>}</h2>
  <ArticleEditor client:only="react" categories={cats} initial={initial} corrections={corrections} />
  <h3 style="margin-top:2rem">संपादन इतिहास</h3>
  {revisions.length === 0 ? <p>अद्याप जुनी आवृत्ती नाही. शीर्षक किंवा मजकूर बदलून जतन केल्यावर आधीची आवृत्ती येथे दिसेल.</p> : (
    <div class="tablewrap"><table><thead><tr><th>जतन वेळ</th><th>कोणी</th><th>त्या वेळचे शीर्षक</th><th></th></tr></thead><tbody>
      {revisions.map((r) => <tr><td>{fmtDate(r.saved_at)}</td><td>{r.name ?? '-'}</td><td>{r.headline}</td>
        <td><a href={`/admin/articles/${id}/history?rev=${r.id}`}>पहा / फरक</a></td></tr>)}
    </tbody></table></div>)}
</AdminLayout>
