---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDB } from '../../lib/db';
import { back, readForm, slugify } from '../../lib/admin';
const db = getDB(Astro.locals);
if (Astro.request.method === 'POST') {
  const { str, int } = await readForm(Astro.request);
  const action = str('action');
  const id = int('id');
  const name = str('name_mr', 60), slug = slugify(str('slug', 60)), order = int('sort_order') || 0;
  if (action === 'save' || action === 'add') {
    if (!name) return back(Astro.url, 'मराठी नाव लिहा.', true);
    if (!slug) return back(Astro.url, 'Slug इंग्रजी अक्षरे/अंकांत लिहा (उदा. pune-city).', true);
    const clash = await db.prepare('SELECT id FROM categories WHERE slug = ? AND id <> ?').bind(slug, action === 'add' ? 0 : id).first();
    if (clash) return back(Astro.url, 'हा slug आधीच वापरात आहे.', true);
    if (action === 'add') await db.prepare('INSERT INTO categories (slug, name_mr, sort_order) VALUES (?,?,?)').bind(slug, name, order).first();
    else await db.prepare('UPDATE categories SET slug=?, name_mr=?, sort_order=? WHERE id=?').bind(slug, name, order, id).first();
    return back(Astro.url, 'विभाग जतन केला.');
  }
  if (action === 'toggle') {
    await db.prepare('UPDATE categories SET is_active = 1 - is_active WHERE id = ?').bind(id).first();
    return back(Astro.url, 'विभागाची स्थिती बदलली.');
  }
  if (action === 'delete') {
    const used = await db.prepare('SELECT COUNT(*) AS n FROM articles WHERE category_id = ?').bind(id).first<{ n: number }>();
    if ((used?.n ?? 0) > 0) return back(Astro.url, `या विभागात ${used!.n} बातम्या आहेत, म्हणून तो हटवता येणार नाही. त्याऐवजी “लपवा” वापरा.`, true);
    await db.prepare('DELETE FROM categories WHERE id = ?').bind(id).first();
    return back(Astro.url, 'विभाग हटवला.');
  }
}
const cats = (await db.prepare(
  `SELECT c.id, c.slug, c.name_mr, c.sort_order, c.is_active, (SELECT COUNT(*) FROM articles a WHERE a.category_id = c.id) AS n
   FROM categories c ORDER BY c.sort_order, c.id`).all<{ id: number; slug: string; name_mr: string; sort_order: number; is_active: number; n: number }>()).results;
---
<AdminLayout title="Categories">
  <h2>विभाग (Categories)</h2>
  <div class="tablewrap"><table><thead><tr><th>मराठी नाव</th><th>Slug (URL)</th><th>क्रम</th><th>बातम्या</th><th>स्थिती</th><th></th></tr></thead><tbody>
    {cats.map((c) => <tr>
      <td colspan="3"><form method="post" style="display:grid;grid-template-columns:2fr 2fr 70px auto;gap:.4rem;align-items:center">
        <input type="hidden" name="id" value={c.id} /><input type="hidden" name="action" value="save" />
        <input name="name_mr" value={c.name_mr} required maxlength="60" aria-label="मराठी नाव" />
        <input name="slug" value={c.slug} required pattern="[a-z0-9\-]+" aria-label="slug" />
        <input name="sort_order" type="number" value={c.sort_order} aria-label="क्रम" />
        <button class="sec small" type="submit">जतन</button></form></td>
      <td>{c.n}</td>
      <td><span class={`badge ${c.is_active ? 'on' : 'off'}`}>{c.is_active ? 'दिसतो' : 'लपवलेला'}</span></td>
      <td style="white-space:nowrap">
        <form method="post" class="inline"><input type="hidden" name="id" value={c.id} /><input type="hidden" name="action" value="toggle" />
          <button class="sec small" type="submit">{c.is_active ? 'लपवा' : 'दाखवा'}</button></form>
        {c.n === 0 && <form method="post" class="inline"><input type="hidden" name="id" value={c.id} /><input type="hidden" name="action" value="delete" />
          <button class="danger small" type="submit" data-confirm="हा विभाग हटवायचा?">हटवा</button></form>}
      </td></tr>)}
  </tbody></table></div>
  <h3>नवीन विभाग</h3>
  <form method="post" class="card"><input type="hidden" name="action" value="add" />
    <div class="row">
      <div class="f"><label for="nn">मराठी नाव</label><input id="nn" name="name_mr" required maxlength="60" placeholder="उदा. पुणे शहर" /></div>
      <div class="f"><label for="ns">Slug (इंग्रजी, URL साठी)</label><input id="ns" name="slug" required pattern="[a-z0-9\-]+" placeholder="pune-city" /></div>
      <div class="f"><label for="no">क्रम</label><input id="no" name="sort_order" type="number" value={cats.length + 1} /></div>
    </div>
    <button type="submit">विभाग जोडा</button>
  </form>
  <p><small>ज्या विभागात बातम्या आहेत तो हटवता येत नाही; तो “लपवा” केल्यास मेनूमधून व वेबसाइटवरून दिसणार नाही.</small></p>
</AdminLayout>
