---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDB } from '../../lib/db';
import { fmtDate, fmtSize } from '../../lib/format';
import { getUsage, R2_LIMIT, D1_LIMIT, WRITES_LIMIT } from '../../lib/usage';
import { runBackup } from '../../lib/backup';
import { env } from 'cloudflare:workers';
import { back } from '../../lib/admin';
const db = getDB(Astro.locals);
if (Astro.request.method === 'POST') {
  try {
    const r = await runBackup(db, (env as any).BACKUPS);
    return back(Astro.url, `बॅकअप पूर्ण: backups/latest/ (${r.tables} टेबल, ${(r.bytes / 1024).toFixed(0)} KB). जुना बॅकअप बदलला.`);
  } catch (e) {
    return back(Astro.url, `बॅकअप अयशस्वी: ${(e as Error).message}`, true);
  }
}
const counts = (await db.prepare('SELECT status, COUNT(*) AS n FROM articles GROUP BY status').all<{ status: string; n: number }>()).results;
const n = (s: string) => counts.find((c) => c.status === s)?.n ?? 0;
const other = await db.prepare(
  `SELECT (SELECT COUNT(*) FROM ads WHERE status='active' AND end_date >= date('now')) AS ads, (SELECT COUNT(*) FROM videos) AS videos,
     (SELECT COUNT(*) FROM epapers) AS epapers, (SELECT COUNT(*) FROM media) AS media,
     (SELECT value FROM settings WHERE key='last_backup') AS last_backup`).first<{ ads: number; videos: number; epapers: number; media: number; last_backup: string | null }>();
const recent = (await db.prepare(
  `SELECT id, headline, status, published_at, updated_at FROM articles ORDER BY updated_at DESC LIMIT 8`)
  .all<{ id: number; headline: string; status: string; published_at: string | null; updated_at: string }>()).results;
const u = await getUsage(db);
const meters = [
  ['R2 साठवण (फोटो, ई-पेपर, बॅकअप)', u.r2, R2_LIMIT, fmtSize(u.r2) + ' / 10 GB'],
  ['D1 डेटाबेस आकार', u.d1, D1_LIMIT, fmtSize(u.d1) + ' / 5 GB'],
  ['आजचे D1 writes (अंदाजे, admin बाजूचे)', u.writesToday, WRITES_LIMIT, `${u.writesToday.toLocaleString('mr-IN')} / 1,00,000`],
] as const;
const STATUS: Record<string, string> = { published: '✅ प्रकाशित', draft: '📝 ड्राफ्ट', archived: '📦 आर्काइव्ह' };
const cls = (p: number) => (p >= 80 ? 'r' : p >= 70 ? 'w' : '');
---
<AdminLayout title="Dashboard">
  <h2>नमस्कार, {Astro.locals.user?.name} 🙏</h2>
  <p style="margin-top:-.4rem;color:#57534e">काय करायचे आहे? खालीलपैकी एक निवडा.</p>
  <button id="install-app" type="button">📲 हे ॲप फोन / कॉम्प्युटरवर इन्स्टॉल करा</button>
  <div class="tiles">
    <a class="tile primary" href="/admin/articles/new"><span class="ti">✍️</span><b>नवीन बातमी लिहा</b><small>शीर्षक, मजकूर, फोटो किंवा YouTube व्हिडिओ</small></a>
    <a class="tile" href="/admin/articles"><span class="ti">📰</span><b>बातम्या बदला / हटवा</b><small>प्रकाशित, ड्राफ्ट आणि जुन्या बातम्या</small></a>
    <a class="tile" href="/admin/media"><span class="ti">🖼️</span><b>फोटो अपलोड करा</b><small>बातमी व गॅलरीसाठी फोटो</small></a>
    <a class="tile" href="/admin/videos"><span class="ti">🎬</span><b>YouTube व्हिडिओ जोडा</b><small>लिंक पेस्ट करा, शीर्षक लिहा</small></a>
    <a class="tile" href="/admin/epaper"><span class="ti">📄</span><b>ई-पेपर अपलोड करा</b><small>आजची PDF आवृत्ती</small></a>
    <a class="tile" href="/admin/ads"><span class="ti">📢</span><b>जाहिरात जोडा</b><small>फोटो, लिंक आणि तारखा</small></a>
  </div>
  <h3>आकडेवारी</h3>
  <div class="cards">
    <a class="card" href="/admin/articles?status=published"><b>{n('published')}</b>प्रकाशित बातम्या</a>
    <a class="card" href="/admin/articles?status=draft"><b>{n('draft')}</b>ड्राफ्ट (अप्रकाशित)</a>
    <a class="card" href="/admin/articles?status=archived"><b>{n('archived')}</b>आर्काइव्ह (लपवलेल्या)</a>
    <a class="card" href="/admin/ads"><b>{other?.ads ?? 0}</b>चालू जाहिराती</a>
    <a class="card" href="/admin/videos"><b>{other?.videos ?? 0}</b>व्हिडिओ</a>
    <a class="card" href="/admin/epaper"><b>{other?.epapers ?? 0}</b>ई-पेपर</a>
  </div>

  <details class="card" id="install-help" style="margin-bottom:1rem">
    <summary style="cursor:pointer;font-weight:600">📲 Admin ॲप फोन / कॉम्प्युटरवर कसे इन्स्टॉल करावे?</summary>
    <ul style="line-height:1.8;margin:.6rem 0 0;padding-left:1.2rem">
      <li><b>Android फोन (Chrome):</b> उजवीकडे वरचे <b>⋮</b> (तीन ठिपके) → <b>“ॲप इंस्टॉल करा”</b> (Install app) → <b>इन्स्टॉल करा</b>. हा पर्याय नसल्यास “होम स्क्रीनवर जोडा” (Add to Home screen).</li>
      <li><b>iPhone (Safari):</b> खालचे Share बटण → “Add to Home Screen”.</li>
      <li><b>कॉम्प्युटर (Chrome / Edge):</b> पत्त्याच्या पट्टीतील इन्स्टॉल ⊕ चिन्ह → “Install”.</li>
    </ul>
    <p style="margin:.5rem 0 0;color:#57534e">इन्स्टॉल केल्यावर लोगोसह आयकॉन मिळेल आणि Admin वेगळ्या ॲपसारखे उघडेल. बातम्या जतन करण्यासाठी इंटरनेट लागते.</p>
  </details>
  <h3>मोफत मर्यादा (Usage guard)</h3>
  <div class="card">
    {meters.map(([label, val, max, text]) => {
      const p = Math.min(100, (val / max) * 100);
      return <div style="margin-bottom:.7rem"><b style="font-size:1rem;display:inline">{label}</b>: {text} ({p.toFixed(1)}%)
        <div class="meter"><i class={cls(p)} style={`width:${Math.max(p, 0.5)}%`}></i></div></div>;
    })}
    <small>७०% वर पिवळा आणि ८०% वर लाल इशारा. Cloudflare मध्ये खर्चाची कमाल मर्यादा नाही; ही पट्टी फक्त या वेबसाइटचा वापर दाखवते.
      Worker requests (१,००,०००/दिवस) Cloudflare dashboard → Workers → Metrics मध्ये पहा.</small>
  </div>

  <h3>बॅकअप</h3>
  <div class="card">
    <p style="margin-top:0">शेवटचा बॅकअप: <b>{other?.last_backup ?? 'अद्याप नाही'}</b>. बॅकअप R2 मध्ये खाजगी (private) <code>news24-backups</code> bucket मध्ये एकच प्रत ठेवली जाते; दररोज रात्री ती नव्याने बदलली जाते (फक्त मजकूर, फोटो नाहीत).</p>
    <form method="post"><button type="submit">आता बॅकअप घ्या</button></form>
  </div>

  <h3>अलीकडील बातम्या</h3>
  <div class="tablewrap"><table><thead><tr><th>शीर्षक</th><th>स्थिती</th><th>अद्यतनित</th></tr></thead><tbody>
    {recent.map((a) => <tr><td><a href={`/admin/articles/${a.id}`}>{a.headline}</a></td><td>{STATUS[a.status] ?? a.status}</td><td>{fmtDate(a.updated_at)}</td></tr>)}
  </tbody></table></div>
</AdminLayout>
