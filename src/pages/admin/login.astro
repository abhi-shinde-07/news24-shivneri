---
import { getDB } from '../../lib/db';
import { getUser, verifyPassword, createSession, sessionCookie, tooManyAttempts, recordFailure } from '../../lib/auth';
import { verifyTotp } from '../../lib/totp';
const db = getDB(Astro.locals);
if (await getUser(db, Astro.request)) return Astro.redirect('/admin');
let error = '';
if (Astro.request.method === 'POST') {
  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'local';
  if (await tooManyAttempts(db, ip)) {
    error = 'खूप चुकीचे प्रयत्न झाले. १५ मिनिटांनी पुन्हा प्रयत्न करा.';
  } else {
    const f = await Astro.request.formData();
    const email = String(f.get('email') ?? '').trim().toLowerCase();
    const password = String(f.get('password') ?? '');
    const code = String(f.get('code') ?? '');
    const user = await db.prepare('SELECT id, password_hash, totp_secret, totp_enabled FROM users WHERE email = ?')
      .bind(email).first<{ id: number; password_hash: string; totp_secret: string | null; totp_enabled: number }>();
    const codeOk = !user?.totp_enabled || (!!user.totp_secret && (await verifyTotp(user.totp_secret, code)));
    if (user && (await verifyPassword(password, user.password_hash)) && codeOk) {
      const token = await createSession(db, user.id);
      return new Response(null, { status: 303, headers: {
        Location: '/admin', 'Set-Cookie': sessionCookie(token, Astro.url.protocol === 'https:') } });
    }
    await recordFailure(db, ip);
    error = 'ईमेल, पासवर्ड किंवा कोड चुकीचा आहे.';
  }
}
---
<!doctype html>
<html lang="mr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" /><title>Admin Login – NEWS24 SHIVNERI</title>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="manifest" href="/admin.webmanifest" /><meta name="theme-color" content="#1f0a0d" />
<link rel="apple-touch-icon" href="/icons/admin-192.png" /><meta name="apple-mobile-web-app-capable" content="yes" /><meta name="apple-mobile-web-app-title" content="N24 Admin" />
<style>
  .brand{text-align:center;margin:0 0 1rem;padding-bottom:.9rem;border-bottom:1px solid #e4e4e7}
  .brand img{height:110px;width:110px;margin:0 auto;display:block;border-radius:50%}
  .brand p{margin:.4rem 0 0;color:#c4001f;font-weight:700}
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#1f0a0d;font-family:system-ui,'Noto Sans Devanagari',sans-serif}
  form{background:#fff;border-top:4px solid #c4001f;border-radius:16px;padding:1.6rem;width:min(92vw,360px);box-shadow:0 10px 30px rgba(0,0,0,.35)}
  h1{font-size:1.15rem;margin:0 0 1rem} label{display:block;font-size:.9rem;margin:.7rem 0 .25rem}
  input{width:100%;box-sizing:border-box;padding:.55rem;border:1px solid #cfc9c1;border-radius:8px;font:inherit;padding:.65rem}
  button{margin-top:1rem;width:100%;padding:.6rem;border:0;border-radius:8px;background:#c4001f;padding:.75rem;font-weight:600;color:#fff;font:inherit;cursor:pointer}
  .err{color:#b3001b;font-size:.9rem;margin:.7rem 0 0}
</style></head>
<body>
<form method="post">
  <div class="brand">
    <img src="/logo.png" alt="NEWS24 शिवनेरी" width="1200" height="1200" />
    <p>निर्भिड सत्याचा बुलंद आवाज</p>
  </div>
  <h1>व्यवस्थापन लॉगिन</h1>
  <label for="email">ईमेल</label><input id="email" name="email" type="email" autocomplete="username" required />
  <label for="password">पासवर्ड</label><input id="password" name="password" type="password" autocomplete="current-password" required />
  <label for="code">२-पायरी कोड <small>(चालू केला असल्यासच)</small></label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" />
  {error && <p class="err" role="alert">{error}</p>}
  <button type="submit">लॉगिन</button>
</form>
</body></html>
