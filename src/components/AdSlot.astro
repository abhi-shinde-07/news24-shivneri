---
import { getDB } from '../lib/db';
import { getLiveAds, type Position } from '../lib/ads';
import { mediaUrl } from '../lib/mediaUrl';
// Rendered on the server; the slot disappears completely when no ad is live. Several ads rotate per render.
const { position } = Astro.props as { position: Position };
const ads = (await getLiveAds(getDB(Astro.locals), Astro.locals)).filter((a) => a.position === position);
const ad = ads.length ? ads[Math.floor(Math.random() * ads.length)] : null;
---
{ad && (
  <aside class={`ad-slot ad-${position}`} aria-label="जाहिरात">
    <span class="ad-label">जाहिरात</span>
    <a href={`/go/${ad.id}`} rel="sponsored noopener" target="_blank">
      <img src={mediaUrl(ad.image_key)} alt={`जाहिरात: ${ad.advertiser}`} loading="lazy" decoding="async" />
    </a>
  </aside>
)}
