{
	"name": "news24-shivneri",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS"
	},
	// Nightly backup of the text tables to R2 at 02:30 IST (21:00 UTC). Free: cron triggers cost nothing.
	// The site's own domain (zone must be active on Cloudflare). Cloudflare creates the DNS records and HTTPS certificates.
	"routes": [
		{ "pattern": "www.news24shivneri.in", "custom_domain": true },
		{ "pattern": "news24shivneri.in", "custom_domain": true }
	],
	"triggers": {
		"crons": ["0 21 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "news24-db",
			"database_id": "e0e39593-075c-4983-865d-56355825e094",
			"migrations_dir": "migrations",
			"remote": false
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "news24-media",
			"remote": false
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "ab4f324d12da4fe29d3c949d2e595e27",
			"remote": false
		}
	]
}