{
  "name": "NEWS24 शिवनेरी – व्यवस्थापन",
  "short_name": "N24 Admin",
  "description": "NEWS24 शिवनेरी बातम्या, फोटो, व्हिडिओ आणि ई-पेपर व्यवस्थापन",
  "lang": "mr",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#f5f3ef",
  "theme_color": "#c4001f",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/admin-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "नवीन बातमी लिहा", "short_name": "लिहा", "url": "/admin/articles/new", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "सर्व बातम्या", "short_name": "बातम्या", "url": "/admin/articles", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
